# Your GitHub username
NEXT_PUBLIC_GITHUB_USERNAME="your-github-username"

# Your LinkedIn username
NEXT_PUBLIC_LINKEDIN_USERNAME="your-linkedin-username"

# Your Twitter username
NEXT_PUBLIC_TWITTER_USERNAME="your-twitter-username"

# Your Telegram username
NEXT_PUBLIC_TELEGRAM_USERNAME="your-telegram-username"

# Your Email address
NEXT_PUBLIC_EMAIL_ADDRESS="your-email-address"

#  whether your available for work or not
NEXT_PUBLIC_AVAILABLE_STATUS=true

# Base URL of your deployed app 
# Example: "https://yourdomain.com"
NEXT_PUBLIC_APP_URL="https://yourdomain.com"

# Umami website ID 
NEXT_PUBLIC_UMAMI_WEBSITE_ID="your-umami-site-id"
